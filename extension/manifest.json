{
  "manifest_version": 3,
  "name": "Preciprocal",
  "version": "1.9.0",
  "description": "Autofill job applications without guessing sensitive answers. Ghost-job warnings, reply odds and a job tracker.",
  "permissions": [
    "storage",
    "activeTab",
    "scripting",
    "tabs",
    "notifications"
  ],
  "host_permissions": [
    "<all_urls>"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "action": {
    "default_popup": "popup.html",
    "default_icon": {
      "16": "icons/icon16.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },
  "content_scripts": [
    {
      "matches": [
        "https://www.linkedin.com/*"
      ],
      "js": [
        "sensitive-answers.js",
        "everify-badge.js",
        "upsell.js",
        "banner.js"
      ],
      "css": [
        "content.css"
      ],
      "run_at": "document_idle"
    },
    {
      "matches": [
        "https://boards.greenhouse.io/*",
        "https://job-boards.greenhouse.io/*",
        "https://boards.eu.greenhouse.io/*",
        "https://job-boards.eu.greenhouse.io/*",
        "https://jobs.lever.co/*",
        "https://jobs.eu.lever.co/*",
        "https://jobs.ashbyhq.com/*",
        "https://*.myworkdayjobs.com/*",
        "https://*.myworkdaysite.com/*",
        "https://*.indeed.com/*",
        "https://*.icims.com/*",
        "https://jobs.jobvite.com/*",
        "https://jobs.smartrecruiters.com/*",
        "https://careers.smartrecruiters.com/*",
        "https://*.taleo.net/*",
        "https://*.successfactors.com/career*",
        "https://*.successfactors.eu/career*",
        "https://*.bamboohr.com/careers*",
        "https://*.bamboohr.com/jobs*",
        "https://*.recruitee.com/*",
        "https://*.applytojob.com/*",
        "https://wellfound.com/jobs*",
        "https://wellfound.com/company/*/jobs*",
        "https://ats.rippling.com/*",
        "https://*.pinpointhq.com/*",
        "https://app.dover.com/apply/*",
        "https://app.dover.com/jobs/*",
        "https://apply.workable.com/*",
        "https://jobs.workable.com/*",
        "https://*.breezy.hr/*",
        "https://jobs.polymer.co/*",
        "https://www.comeet.com/jobs/*",
        "https://*.teamtailor.com/*",
        "https://*.jobs.personio.de/*",
        "https://*.jobs.personio.com/*",
        "https://careers.jobscore.com/*",
        "https://recruiting.paylocity.com/*",
        "https://www.paycomonline.net/v4/ats/*",
        "https://workforcenow.adp.com/mascsr/*",
        "https://myjobs.adp.com/*",
        "https://recruiting.adp.com/*",
        "https://recruiting.ultipro.com/*",
        "https://recruiting2.ultipro.com/*",
        "https://jobs.dayforcehcm.com/*",
        "https://*.oraclecloud.com/hcmUI/CandidateExperience/*",
        "https://join.com/companies/*",
        "https://*.jobspage.co/*",
        "https://*.careers/*",
        "https://*.jobs/*"
      ],
      "js": [
        "sensitive-answers.js",
        "everify-badge.js",
        "upsell.js",
        "external-apply.js"
      ],
      "css": [
        "content.css"
      ],
      "run_at": "document_idle",
      "all_frames": true,
      "exclude_matches": [
        "https://app.recruitee.com/*",
        "https://app.breezy.hr/*",
        "https://app.teamtailor.com/*",
        "https://app.pinpointhq.com/*",
        "https://employers.indeed.com/*",
        "https://secure.indeed.com/*"
      ]
    },
    {
      "matches": [
        "https://app.preciprocal.com/*",
        "https://preciprocal.com/*",
        "https://www.preciprocal.com/*"
      ],
      "js": [
        "localhost-bridge.js"
      ],
      "run_at": "document_idle"
    }
  ],
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "web_accessible_resources": [
    {
      "resources": [
        "icons/icon16.png",
        "icons/icon48.png",
        "icons/icon128.png",
        "external-apply.js",
        "content.css",
        "localhost-bridge.js"
      ],
      "matches": [
        "<all_urls>"
      ]
    }
  ]
}
